# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública da Edge Function do chat de IA (Rô).
# Apresentação/produção: a URL do Supabase abaixo. NUNCA localhost em produção.
# Desenvolvimento no PC (npm run chat:dev): http://localhost:8000
# A chave da LLM NÃO fica aqui — ela fica em supabase/functions/.env (ver docs/CHAT.md).
EXPO_PUBLIC_CHAT_FUNCTION_URL=https://SEU-PROJETO.supabase.co/functions/v1/chat

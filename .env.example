# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública da Edge Function do chat de IA (proxy).
# A chave da LLM NÃO fica aqui — ela é um secret da Edge Function no Supabase.
EXPO_PUBLIC_CHAT_FUNCTION_URL=https://SEU-PROJETO.supabase.co/functions/v1/chat

# ---- Secrets da Edge Function (configurar com `supabase secrets set`, nunca no app) ----
# LLM_API_KEY=...

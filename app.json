{
  "expo": {
    "name": "Rolê que Rende",
    "slug": "role-que-rende",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rolequerende",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Rolê que Rende usa a câmera só quando você quer registrar uma missão concluída com uma foto. A foto fica apenas no seu aparelho.",
          "photosPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "Rolê que Rende",
    "slug": "role-que-rende",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rolequerende",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
